# UPCHAR Auth Service
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=upchar-dev-jwt-secret-change-me
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# MongoDB — leave empty / set USE_MEMORY_MONGO=true for embedded Mongo
MONGODB_URI=
USE_MEMORY_MONGO=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# If Atlas is unreachable from this host, fall back to embedded Mongo (dev only)
ALLOW_MEMORY_FALLBACK=true
