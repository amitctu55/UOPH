{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["es2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@apps/*": ["../../apps/*"],
      "@services/*": ["../*"],
      "@libs/*": ["../../libs/*"],
      "@mobile/*": ["../../mobile/*"]
    }
  },
  "exclude": ["node_modules", "dist", "test", "spec", "acceptance", "e2e", "**/*.spec.ts"]
}
