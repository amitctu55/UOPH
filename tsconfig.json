{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "es2020"
    ],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@libs/*": ["libs/*/src"]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}